#!/usr/bin/env bash
# git commit-msg hook — validate commit message structure.
#
# Delegates to `harnex validate commit-msg` when the binary is available;
# otherwise skips. The oracle validates closed-enum trailer values and
# required-trailer presence.
#
# Fail-open: missing harnex binary → skip.
# Escape hatch via HARNEX_SKIP_COMMITMSG=1. Set, it says so on the commit it
# skips: a floor that is off silently is a floor nobody knows is off.
set -uo pipefail

if [[ "${HARNEX_SKIP_COMMITMSG:-}" == "1" ]]; then
  echo "[harnex] commit-message check skipped by operator override." >&2
  exit 0
fi

command -v harnex >/dev/null 2>&1 || exit 0

OUTPUT=$(harnex validate commit-msg "$1" 2>&1)
STATUS=$?

case $STATUS in
  0) exit 0 ;;
  1) echo "[harnex] commit message validation failed:" >&2
     echo "$OUTPUT" >&2
     exit 1 ;;
  *) exit 0 ;;
esac
