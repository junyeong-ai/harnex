{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact|fork",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PROJECT_DIR}/hooks/_runner.sh",
          "args": [
            "session-start.sh"
          ],
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PROJECT_DIR}/hooks/_stop_runner.sh",
          "args": [
            "check-on-stop.sh"
          ],
          "timeout": 30
        }
      ]
    }
  ]
}
