# Solo-developer baseline: file claims are resolved, and telemetry stays small
# (1MB rotation).

[meta]
harnex_version = ">=0.38.1, <0.39"

[evidence]

[telemetry]
storage = "jsonl"
storage_dir = ".harness/telemetry"
rotate_at_mb = 1

[[telemetry.kinds]]
name = "skill-invoked"

[telemetry.kinds.payload_schema]
type = "object"
required = ["skill", "outcome"]

[telemetry.kinds.payload_schema.properties.skill]
type = "string"

[telemetry.kinds.payload_schema.properties.outcome]
type = "string"
enum = ["ok", "warn", "fail"]

[telemetry.kinds.payload_schema.properties.duration_ms]
type = "integer"
